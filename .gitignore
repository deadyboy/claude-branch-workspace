
# Claude session/local metadata (never publish)
.claude/

node_modules/
dist/
build/
coverage/
.env
.env.*
*.log
.DS_Store
Thumbs.db

# local runtime/database artifacts (implementation may refine)
data/
tmp/
.tmp/
.worktrees/

# runtime experiment artifacts (never commit transient probe state)
.runtime-experiments/

# per-branch adapter settings (runtime writes these to <cwd>/.cbw/)
.cbw*

# Playwright run artifacts (regenerated every e2e run)
test-results/
playwright-report/
